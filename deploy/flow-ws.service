[Unit]
Description=Flow WebSocket Worker (UW real-time alerts)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=flowws
WorkingDirectory=/opt/flow-ws
EnvironmentFile=/opt/flow-ws/.env
ExecStart=/opt/flow-ws/venv/bin/python /opt/flow-ws/src/ws_worker.py
Restart=always
RestartSec=10
StandardOutput=append:/var/log/flow-ws.log
StandardError=append:/var/log/flow-ws.log

[Install]
WantedBy=multi-user.target
